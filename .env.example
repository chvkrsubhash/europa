# Europa — AkashaVyom Labs Environment Configuration
APP_NAME=Europa
APP_TAGLINE=Digital Notebook & AI Knowledge Workspace
BRAND_NAME=AkashaVyom Labs
VERSION=1.0.0

# Environment & Security
ENV=development
SECRET_KEY=akashavyom-europa-production-secret-key-replace-in-prod
ALGORITHM=HS256

# Database
# If left empty, Europa seamlessly runs on the local persistent document store (Zero config!)
# For production MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
DATABASE_NAME=europa_notebook_db

# AI Provider Configuration
# Supported providers: gemini | groq | openrouter | ollama | europa-local
DEFAULT_AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Titan Integration
TITAN_APP_URL=http://localhost:3000
TITAN_SSO_SHARED_SECRET=titan-akashavyom-shared-secret

